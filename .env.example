# ───────────────────────────────────────────────────────────────
# MODELO das variáveis de ambiente — copie para ".env" (local) OU
# cadastre no painel do Cloudflare Pages (Settings → Variables and Secrets).
# NUNCA faça commit do ".env" real (ele já está no .gitignore).
# ───────────────────────────────────────────────────────────────

# senha de equipe (conferida na Function verifica-senha)
SENHA_EQUIPE=troque-esta-senha

# conta de serviço do Firebase (JSON em uma linha) — usada pela Function
# verifica-senha para emitir o custom token com a claim { equipe: true }.
FB_SERVICE_ACCOUNT={"type":"service_account", ...cole o JSON aqui...}
