# ───────────────────────────────────────────────────────────────
# MODELO das variáveis de ambiente — copie para ".env" (local) OU
# cadastre no painel do Cloudflare Pages (Settings → Variables and Secrets).
# NUNCA faça commit do ".env" real (ele já está no .gitignore).
# ───────────────────────────────────────────────────────────────

# Passo 4 — senha de equipe (conferida na Function verifica-senha)
SENHA_EQUIPE=troque-esta-senha

# Passo 5 — Cloudflare Workers AI (Function ler-placa)
CF_ACCOUNT_ID=seu-account-id-do-cloudflare
CF_API_TOKEN=seu-api-token-do-cloudflare
CF_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
