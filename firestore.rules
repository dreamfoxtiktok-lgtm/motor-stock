rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Motor Stock — Security Rules (Passo 3.3, versão com validação)
// Cole TUDO isto em: Firebase → Firestore Database → aba "Regras".
// Além de exigir login (anônimo, liberado pela Function de senha),
// trava os campos permitidos e valida tipo/tamanho — assim nem um
// cliente autenticado consegue gravar campos arbitrários ou lixo.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // valida a forma de um documento de motor
    // Limites alinhados aos valores REAIS que o app grava, incluindo os que a
    // leitura por foto (IA) pode produzir — mais folgados que a 1ª versão, que
    // barrava dado válido (obs/rpm/fs/polos eram curtos demais). Ainda trava
    // campos arbitrários (hasOnly) e valida tipo, mantendo a proteção.
    function motorValido(d) {
      return d.keys().hasOnly(['tag','carcaca','fabricante','potencia','amp','fs',
                               'rpm','polos','eixo','obs','endereco',
                               'flange','flangeFuros','baseFixacao',
                               'redutora','reducao',
                               'status','localAtual','historico',
                               'testado','dataTeste','turnoTeste',
                               'temFoto','temFoto2',
                               'createdAt','updatedAt','createdTS'])
        // obrigatórios
        && 'carcaca'  in d && d.carcaca  is string && d.carcaca.size()  >= 1 && d.carcaca.size()  <= 60
        && 'potencia' in d && d.potencia is string && d.potencia.size() >= 1 && d.potencia.size() <= 80
        // opcionais (quando presentes, precisam ser string dentro do limite)
        && (!('tag'        in d) || (d.tag        is string && d.tag.size()        <= 60))
        && (!('fabricante' in d) || (d.fabricante is string && d.fabricante.size() <= 80))
        && (!('amp'        in d) || (d.amp        is string && d.amp.size()        <= 60))
        && (!('fs'         in d) || (d.fs         is string && d.fs.size()         <= 40))
        && (!('rpm'        in d) || (d.rpm        is string && d.rpm.size()        <= 40))
        && (!('polos'      in d) || (d.polos      is string && d.polos.size()      <= 15))
        && (!('eixo'       in d) || (d.eixo       is string && d.eixo.size()       <= 40))
        && (!('obs'        in d) || (d.obs        is string && d.obs.size()        <= 600))
        && (!('endereco'   in d) || (d.endereco   is string && d.endereco.size()   <= 120))
        // campos mecânicos novos: flange/base (boolean) e nº de furos (number 0..100)
        && (!('flange'      in d) || d.flange      is bool)
        && (!('baseFixacao' in d) || d.baseFixacao is bool)
        && (!('flangeFuros' in d) || (d.flangeFuros is number && d.flangeFuros >= 0 && d.flangeFuros <= 100))
        // redutora (boolean) e redução (string, ex.: "1:30")
        && (!('redutora'   in d) || d.redutora is bool)
        && (!('reducao'    in d) || (d.reducao   is string && d.reducao.size()   <= 40))
        // movimentação/status: status (string), localAtual (string), historico (array)
        && (!('status'     in d) || (d.status     is string && d.status.size()     <= 20))
        && (!('localAtual' in d) || (d.localAtual is string && d.localAtual.size() <= 120))
        && (!('historico'  in d) || (d.historico is list && d.historico.size() <= 500))
        // teste: testado (bool); dataTeste/turnoTeste (string) só quando testado = true
        && (!('testado'    in d) || d.testado is bool)
        && (!('temFoto'    in d) || d.temFoto is bool)
        && (!('temFoto2'   in d) || d.temFoto2 is bool)
        && (!('dataTeste'  in d) || (d.dataTeste  is string && d.dataTeste.size()  <= 20))
        && (!('turnoTeste' in d) || (d.turnoTeste is string && d.turnoTeste.size() <= 20))
        && (!('createdAt'  in d) || (d.createdAt  is string && d.createdAt.size()  <= 20))
        && (!('updatedAt'  in d) || (d.updatedAt  is string && d.updatedAt.size()  <= 20))
        && (!('createdTS'  in d) || d.createdTS is number);
    }

    // BLINDAGEM: exige a claim 'equipe' (só quem acerta a senha e recebe o custom
    // token da Function tem essa claim). Login anônimo direto (com a config pública)
    // NÃO tem a claim → não lê nem escreve. Assim a senha protege os DADOS.
    // ⚠ PUBLICAR estas regras só DEPOIS de: (1) secret FB_SERVICE_ACCOUNT no Cloudflare,
    // (2) deploy do app novo, (3) teste de login OK. Antes disso, manter a regra antiga.
    function daEquipe() { return request.auth != null && request.auth.token.equipe == true; }

    match /motores/{doc} {
      allow read:   if daEquipe();
      allow create: if daEquipe() && motorValido(request.resource.data);
      allow update: if daEquipe() && motorValido(request.resource.data);
      allow delete: if daEquipe();
    }

    // ─────────────────────────────────────────────────────────────
    // ÍNDICE DE TAGS — unicidade da tag no SERVIDOR.
    // 1 documento por tag (id = TAG em maiúsculas). O app cria o doc da tag no
    // MESMO batch do motor. Como UPDATE é proibido aqui, tentar reservar uma tag
    // que já existe vira update → o batch inteiro falha → tag não duplica, nem
    // numa corrida entre dois aparelhos offline. delete libera a tag.
    // ─────────────────────────────────────────────────────────────
    function tagValida(d) {
      return d.keys().hasOnly(['motorId','tag','createdTS'])
        && 'tag'     in d && d.tag     is string && d.tag.size()     >= 1 && d.tag.size() <= 60
        && 'motorId' in d && d.motorId is string && d.motorId.size() >= 1 && d.motorId.size() <= 200
        && (!('createdTS' in d) || d.createdTS is number);
    }
    match /tags/{tag} {
      allow read:   if daEquipe();
      allow create: if daEquipe() && tagValida(request.resource.data);
      allow update: if false;        // nunca atualiza → recriar tag existente falha (unicidade)
      allow delete: if daEquipe();
    }

    // ─────────────────────────────────────────────────────────────
    // FOTOS DO MOTOR — 1 documento por motor (/fotos/{motorId}), guardado FORA do
    // doc do motor pra não pesar a sincronização em tempo real da lista. Até 2
    // imagens base64 no MESMO doc: 'img'/'mime' (foto 1) e 'img2'/'mime2' (foto 2).
    // Cada foto é comprimida pra ~460 KB antes de enviar, de modo que as duas
    // juntas caibam no limite de ~1 MB de um documento do Firestore.
    // Exige pelo menos UMA das imagens (o app apaga o doc quando não sobra nenhuma).
    // ─────────────────────────────────────────────────────────────
    function fotoValida(d) {
      return d.keys().hasOnly(['img','mime','img2','mime2','updatedTS'])
        && ('img' in d || 'img2' in d)
        && (!('img'  in d) || (d.img  is string && d.img.size()  >= 1 && d.img.size()  <= 520000))
        && (!('img2' in d) || (d.img2 is string && d.img2.size() >= 1 && d.img2.size() <= 520000))
        && (!('mime'  in d) || (d.mime  is string && d.mime.size()  <= 40))
        && (!('mime2' in d) || (d.mime2 is string && d.mime2.size() <= 40))
        && (!('updatedTS' in d) || d.updatedTS is number);
    }
    match /fotos/{motorId} {
      allow read:   if daEquipe();
      allow create: if daEquipe() && fotoValida(request.resource.data);
      allow update: if daEquipe() && fotoValida(request.resource.data);
      allow delete: if daEquipe();
    }

    // nega tudo que não casar acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
